# 排除不需要打入镜像的文件 (加速构建, 减小体积)
node_modules/
.git/
.DS_Store
*.log
# 2026-09-12: .env 必须排除 —— 否则 `COPY . .` 会把含全部密钥的 .env 烤进镜像层,
#   镜像一旦推到 registry 即全量泄露. 运行时由 docker-compose bind mount 注入.
.env
.env.*
uploads/
sessions/
.cache/
outputs/
logs/
public/downloads/
docker/insurance-deck/  # 通过 Dockerfile 单独 COPY
docker/training/data/uploads/  # 2026-08-17: 培训学员上传视频 (14GB on ECS, 走 bind mount 不进 image)
docker/training/data/prisma/dev.db  # SQLite 在 ECS bind mount, 也不进 image
.vscode/
.idea/