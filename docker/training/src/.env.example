# ============================================================
# 融合以琳 AI 培训系统 - 环境变量配置
# ============================================================
# 复制此文件为 .env 并按需修改:
#   cp .env.example .env
# ============================================================

# -------- 数据库 ----------
# 开发环境可使用 SQLite:
DATABASE_URL="file:./dev.db"
# 生产环境可替换为 PostgreSQL:
# DATABASE_URL="postgresql://user:password@localhost:5432/training?schema=public"

# -------- JWT ----------
# JWT 签名密钥（必须配置，否则服务无法启动）
# 生成方式: openssl rand -hex 32
JWT_SECRET="replace-with-a-random-secret-at-least-32-chars"

# -------- 服务端口 ----------
PORT=3000

# -------- 腾讯云 VOD（可选，视频相关） ----------
# VOD_APP_ID="125xxxxxxx"
# VOD_SECRET_ID="your-secret-id"
# VOD_SECRET_KEY="your-secret-key"
